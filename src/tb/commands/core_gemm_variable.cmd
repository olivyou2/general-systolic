# Variable-size GEMM and persistent-accumulator test.
#
# First operation: M=2, N=3, K=5. Run two K tiles without an intermediate
# drain. Tile 0 contributes 5, tile 1 contributes 10, so the final value is 15.

WRITE f0000080 0000000000000002   # GEMM M = 2
WRITE f0000084 0000000000000003   # GEMM N = 3
WRITE f0000088 0000000000000005   # GEMM K = 5
WRITE f0000010 0000000000000000   # A base = 0
WRITE f0000014 0000000000000000   # B base = 0
WRITE f0000018 0000000000000000   # C base = 0

# A tile 0: two active rows, five values of 1 in each row.
WRITE 00000000 0000000101010101
WRITE 00000200 0000000101010101

# B tile 0: five K banks, three active output columns of 1.
WRITE 10000000 0000000000010101
WRITE 10000200 0000000000010101
WRITE 10000400 0000000000010101
WRITE 10000600 0000000000010101
WRITE 10000800 0000000000010101

WRITE f000008c 0000000000000001   # clear=1, final/drain=0
WRITE f0000000 0000000000000002   # GEMM launch
WAIT 20
EXPECT_NONE 2

# A tile 1 contributes 2*1 five times. Keep the existing accumulator.
WRITE 00000000 0000000202020202
WRITE 00000200 0000000202020202
WRITE f000008c 0000000000000002   # clear=0, final/drain=1
WRITE f0000000 0000000000000002
WAIT 30

WRITE f0000020 0000000000000000   # DMA destination = external
WRITE f0000024 0000000000000000   # C source base = 0
WRITE f000002c 0000000000000002   # two active M rows
WRITE f0000000 0000000000000001
EXPECT 00000000000f0f0f
EXPECT 00000000000f0f0f

# Second operation: M=1, N=1, K=10. This crosses the eight-lane A word and
# eight-bank B boundary and verifies the k/8 address rollover.
WRITE f0000080 0000000000000001
WRITE f0000084 0000000000000001
WRITE f0000088 000000000000000a
WRITE f0000018 0000000000000010   # C base = 16

WRITE 00000000 0101010101010101   # A k=0..7
WRITE 00000001 0000000000000101   # A k=8..9

WRITE 10000000 0000000000000001
WRITE 10000200 0000000000000001
WRITE 10000400 0000000000000001
WRITE 10000600 0000000000000001
WRITE 10000800 0000000000000001
WRITE 10000a00 0000000000000001
WRITE 10000c00 0000000000000001
WRITE 10000e00 0000000000000001
WRITE 10000001 0000000000000001   # B k=8
WRITE 10000201 0000000000000001   # B k=9

WRITE f000008c 0000000000000003   # clear=1, final/drain=1
WRITE f0000000 0000000000000002
WAIT 35

WRITE f0000024 0000000000000010
WRITE f000002c 0000000000000001
WRITE f0000000 0000000000000001
EXPECT 000000000000000a
END
